# ==============================================================================
# FICHIER D'EXEMPLE DE VARIABLES D'ENVIRONNEMENT (MAISON CÉLESTE / ORLEA JEWELS)
# ==============================================================================
# Renommez ce fichier en ".env" ou ".env.local" pour définir vos valeurs locales.
# Pour la production sur Vercel ou Netlify, ajoutez ces variables dans les paramètres du projet.

# Mode de l'environnement (development | production)
VITE_APP_ENV=production

# Nom de la boutique par défaut
VITE_STORE_NAME="Maison Céleste"

# Numéro de contact WhatsApp pour les confirmations de commandes (Format international sans espace, ex: 213555123456)
VITE_WHATSAPP_PHONE="213555123456"

# Code PIN par défaut pour l'accès au tableau de bord administrateur (4 chiffres)
VITE_ADMIN_PIN="1234"

# Identifiants de Tracking Marketing (Optionnels)
VITE_META_PIXEL_ID=""
VITE_TIKTOK_PIXEL_ID=""

# [ÉVOLUTION FUTURE] Configuration Supabase (Si migration vers base de données distante)
# VITE_SUPABASE_URL=https://votre-projet.supabase.co
# VITE_SUPABASE_ANON_KEY=votre-cle-publique-anon
